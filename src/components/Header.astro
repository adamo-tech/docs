---
import config from "virtual:starlight/user-config";

import Search from "virtual:starlight/components/Search";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import logoUrl from "../assets/logo.svg";
import { pathIn, versionOf, versions } from "../versions";

const currentVersion = versionOf(Astro.url.pathname);

const shouldRenderSearch =
  config.pagefind || config.components.Search !== "@astrojs/starlight/components/Search.astro";
---

<div class="adamo-header-shell">
  <nav class="adamo-docs-nav" aria-label="Primary">
    <a class="adamo-nav-logo" href="/" aria-label="Adamo docs home">
      <img src={logoUrl.src} alt="" width="75" height="13" />
    </a>

    <div class="adamo-nav-group">
      <details class="adamo-version-menu">
        <summary class="adamo-version-select" aria-label={`Docs version: ${currentVersion.label}`}>
          {currentVersion.label}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <ul class="adamo-version-options" aria-label="Docs version">
          {versions.map((version) => (
            <li>
              <a href={pathIn(version, Astro.url.pathname)} aria-current={version === currentVersion ? "page" : undefined}>
                {version.label}
                {version === currentVersion && (
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="m5 12 4 4L19 6" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </details>
      <a class="adamo-nav-link adamo-nav-link--desktop" href="https://adamohq.com/">Main site</a>
      <a
        class="adamo-nav-link adamo-nav-link--desktop adamo-nav-link--login"
        href="https://operate.adamohq.com/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Log in
      </a>
    </div>

    <div class="adamo-nav-search print:hidden">
      {shouldRenderSearch && <Search />}
    </div>

    <div class="adamo-nav-actions print:hidden">
      <div class="adamo-social sl-flex" aria-label="Social links">
        <SocialIcons />
      </div>
      <a
        class="adamo-nav-cta"
        href="https://calendar.app.google/EmYvu5zPqcrKrJZX9"
        target="_blank"
        rel="noopener noreferrer"
      >
        Talk to a dev
      </a>
    </div>
  </nav>
</div>

<script>
  const nav = document.querySelector(".adamo-docs-nav");
  const collapseAfter = 144;
  const expandBefore = 24;

  function syncCollapsedState() {
    if (!nav) return;

    if (window.scrollY > collapseAfter) {
      nav.setAttribute("data-scrolled", "");
    } else if (window.scrollY < expandBefore) {
      nav.removeAttribute("data-scrolled");
    }
  }

  const versionMenu = document.querySelector<HTMLDetailsElement>(".adamo-version-menu");
  document.addEventListener("click", (event) => {
    if (versionMenu && !versionMenu.contains(event.target as Node)) versionMenu.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && versionMenu?.open) {
      const hadFocus = versionMenu.contains(document.activeElement);
      versionMenu.open = false;
      if (hadFocus) versionMenu.querySelector("summary")?.focus();
    }
  });

  syncCollapsedState();
  window.addEventListener("scroll", syncCollapsedState, { passive: true });
</script>
